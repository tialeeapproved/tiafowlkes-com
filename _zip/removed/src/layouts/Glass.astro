---
import '../styles/glass.css';
import Mesh from '../components/Mesh.astro';
import GlassBar from '../components/GlassBar.astro';
import { site } from '../data/site';
import { getFolder, type FolderId } from '../data/folders';

interface Props {
  active: FolderId;
  lead: string;
}

const { active, lead } = Astro.props;
const folder = getFolder(active)!;
const pageTitle = `${folder.label} — ${site.name}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={lead} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={lead} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#050505" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400&display=swap"
    />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <Mesh />
    <GlassBar active={active} />

    <main class="page" id="main">
      <header class="lead">
        <p class="label">{folder.question}</p>
        <h1>{folder.label}</h1>
        <p class="sub">{lead}</p>
      </header>

      <slot />
    </main>

    <footer class="foot">
      <span class="meta">© {new Date().getFullYear()} {site.name}</span>
      <a href="/" class="meta back">← Desktop</a>
    </footer>
  </body>
</html>

<style>
  .page {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    padding: 72px 32px 0;
  }

  .lead {
    max-width: 720px;
    padding-bottom: 64px;
  }

  .label {
    margin-bottom: 18px;
  }

  h1 {
    margin-bottom: 22px;
    font-size: clamp(34px, 5.4vw, 56px);
    font-weight: 300;
    letter-spacing: -0.04em;
    line-height: 1.08;
    background: linear-gradient(180deg, #fff 0%, rgba(255, 255, 255, 0.6) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .sub {
    font-size: 17px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--g-text-2);
  }

  .foot {
    position: relative;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    max-width: 1180px;
    margin: 0 auto;
    padding: 64px 32px 40px;
  }

  .back:hover {
    color: var(--g-text);
  }

  @media (max-width: 720px) {
    .page {
      padding: 44px 18px 0;
    }

    .lead {
      padding-bottom: 40px;
    }

    .sub {
      font-size: 15px;
    }

    .foot {
      padding: 44px 18px 32px;
    }
  }
</style>
