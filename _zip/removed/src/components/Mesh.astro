---
/* The blurred environment behind the glass, generated entirely in
   CSS. The template used a blurred photograph from an external
   host — layered radial gradients give the same soft atmosphere
   with no image to download and nothing external to break. */
---

<div class="mesh" aria-hidden="true"></div>

<style>
  .mesh {
    position: fixed;
    inset: -10%;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(50% 45% at 18% 12%, rgba(60, 96, 150, 0.42) 0%, transparent 70%),
      radial-gradient(45% 40% at 82% 22%, rgba(122, 78, 150, 0.32) 0%, transparent 72%),
      radial-gradient(55% 50% at 70% 88%, rgba(28, 90, 110, 0.34) 0%, transparent 70%),
      radial-gradient(40% 38% at 12% 82%, rgba(140, 96, 60, 0.2) 0%, transparent 70%),
      radial-gradient(90% 80% at 50% 50%, rgba(10, 12, 20, 0.5) 0%, var(--g-bg) 78%);
    filter: blur(60px) saturate(1.15);
  }

  /* A second, slower layer keeps the field from reading flat. */
  .mesh::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(30% 28% at 38% 34%, rgba(255, 255, 255, 0.05) 0%, transparent 70%),
      radial-gradient(26% 24% at 66% 62%, rgba(255, 255, 255, 0.035) 0%, transparent 70%);
    animation: drift 46s ease-in-out infinite alternate;
  }

  @keyframes drift {
    from {
      transform: translate3d(-2%, -1%, 0) scale(1);
    }
    to {
      transform: translate3d(2%, 2%, 0) scale(1.06);
    }
  }
</style>
