---
/* Tia on the desktop, right third, standing on the taskbar.
   `state="out"` renders her hidden and lets a script decide
   whether to play the dissolve — see the note below. */

interface Props {
  state?: 'in' | 'out';
}

const { state = 'in' } = Astro.props;
---

<div class:list={['me', state]} aria-hidden={state === 'out' ? 'true' : undefined}>
  <p class="bubble chrome">
    Hi, I'm Tia. I turn high-ambiguity strategy into scalable systems.
  </p>

  <img
    src="/me/tia.webp"
    srcset="/me/tia.webp 1x, /me/tia@2x.webp 2x"
    width="312"
    height="900"
    alt="Tia Fowlkes"
    decoding="async"
  />
</div>

{
  state === 'out' && (
    <script is:inline>
      {/* She should only dissolve when you have just arrived from the
          desktop. Moving between folders would otherwise flash her in
          and out on every navigation, since each page is a fresh
          document that cannot know where you came from without asking. */}
      (function () {
        var el = document.querySelector('.me.out');
        if (!el) return;
        var from = document.referrer;
        var cameFromDesktop = false;
        try {
          var u = new URL(from);
          cameFromDesktop = u.origin === location.origin && u.pathname === '/';
        } catch (e) {}
        if (cameFromDesktop) el.classList.add('dissolve');
      })();
    </script>
  )
}

<style>
  .me {
    position: fixed;
    right: 3vw;
    bottom: var(--taskbar-h);
    z-index: 15;
    display: flex;
    align-items: flex-start;
    /* Tight to her shoulder — the tail should almost touch. */
    gap: 2px;
    pointer-events: none;
  }

  .me img {
    display: block;
    height: min(74vh, 740px);
    width: auto;
    filter: drop-shadow(0 18px 22px rgba(10, 40, 70, 0.28));
  }

  /* Speaks from her left, level with her face. The offset is a
     share of her height so it tracks the image at any size. */
  .bubble {
    position: relative;
    margin-top: calc(min(74vh, 740px) * 0.1);
    max-width: 250px;
    padding: 12px 14px;
    border: 1px solid rgba(16, 23, 30, 0.12);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 10px 22px -10px rgba(10, 40, 70, 0.4);
    /* Same face as the folder titles. */
    font-family: var(--font-ui);
    font-size: 13px;
    line-height: 1.5;
    color: #10171e;
    text-align: left;
  }

  .bubble::after,
  .bubble::before {
    content: '';
    position: absolute;
    top: 20px;
    width: 0;
    height: 0;
    border: 9px solid transparent;
    border-right: 0;
  }

  .bubble::before {
    right: -10px;
    border-left-color: rgba(16, 23, 30, 0.12);
  }

  .bubble::after {
    right: -9px;
    border-left-color: rgba(255, 255, 255, 0.94);
  }

  /* --- arrival --- */
  .in {
    animation: me-in 0.55s ease-out both;
  }

  @keyframes me-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* --- exit ---
     Hidden by default on folder pages. Only the script adds
     .dissolve, and only when you arrived from the desktop. */
  .out {
    opacity: 0;
    visibility: hidden;
  }

  /* A plain fade out. */
  .out.dissolve {
    visibility: visible;
    animation: me-dissolve 0.5s ease-out both;
  }

  @keyframes me-dissolve {
    0% {
      opacity: 1;
    }
    99% {
      opacity: 0;
      visibility: visible;
    }
    100% {
      opacity: 0;
      visibility: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .in {
      animation: none;
    }

    .out.dissolve {
      animation: none;
      opacity: 0;
      visibility: hidden;
    }
  }

  @media (max-width: 1180px) {
    .me {
      display: none;
    }
  }
</style>
