---
import { folders } from '../data/folders';
import type { FolderId } from '../data/folders';

interface Props {
  active?: FolderId;
}

const { active } = Astro.props;
---

<nav class="icons" aria-label="Folders">
  {
    folders.map((f) => (
      <a
        href={`/${f.id}`}
        class:list={['icon', { active: f.id === active }]}
        aria-current={f.id === active ? 'page' : undefined}
      >
        <span class="glyph" aria-hidden="true">
          <svg viewBox="0 0 64 50" width="64" height="50">
            <path
              d="M2 8a6 6 0 0 1 6-6h14.9a6 6 0 0 1 4.24 1.76L30.6 7.3H56a6 6 0 0 1 6 6v29a6 6 0 0 1-6 6H8a6 6 0 0 1-6-6V8Z"
              class="folder-back"
            />
            <path
              d="M2 16h60v26a6 6 0 0 1-6 6H8a6 6 0 0 1-6-6V16Z"
              class="folder-front"
            />
          </svg>
        </span>
        <span class="label">{f.label}</span>
      </a>
    ))
  }
</nav>

<style>
  .icons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s6);
  }

  .icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    padding: var(--s1);
    border-radius: var(--radius);
  }

  .icon:hover {
    color: inherit;
  }

  .folder-back {
    fill: #2b2b36;
    transition: fill 0.15s ease;
  }

  .folder-front {
    fill: #383844;
    transition: fill 0.15s ease;
  }

  .icon:hover .folder-back,
  .icon.active .folder-back {
    fill: var(--accent-line);
  }

  .icon:hover .folder-front,
  .icon.active .folder-front {
    fill: var(--accent);
  }

  .label {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    transition: color 0.15s ease;
  }

  .icon:hover .label,
  .icon.active .label {
    color: var(--accent);
  }

  @media (max-width: 760px) {
    .icons {
      gap: var(--s4) var(--s3);
      justify-content: flex-start;
    }

    .icon {
      width: calc(50% - var(--s3));
      align-items: flex-start;
    }
  }
</style>
