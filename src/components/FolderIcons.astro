---
import { folders } from '../data/folders';
import type { FolderId } from '../data/folders';

interface Props {
  active: FolderId;
  counts: Record<string, number>;
}

const { active, counts } = Astro.props;
---

<nav class="icons" aria-label="Folders">
  {
    folders.map((f) => (
      <a
        href={`/${f.id}`}
        class:list={['icon', { active: f.id === active }]}
        aria-current={f.id === active ? 'page' : undefined}
      >
        <span class="glyph" aria-hidden="true">
          <svg viewBox="0 0 48 38" width="48" height="38">
            <path
              d="M2 6a4 4 0 0 1 4-4h11.2a4 4 0 0 1 2.83 1.17L23.2 6.3H42a4 4 0 0 1 4 4v22a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V6Z"
              class="folder-back"
            />
            <path
              d="M2 13h44v19a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V13Z"
              class="folder-front"
            />
          </svg>
          <span class="count">{counts[f.id] ?? 0}</span>
        </span>
        <span class="label">{f.label}</span>
        <span class="caption">{f.caption}</span>
      </a>
    ))
  }
</nav>

<style>
  .icons {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s2);
    padding-bottom: var(--s4);
  }

  .icon {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    padding: var(--s2);
    border: 1px solid transparent;
    border-radius: var(--radius);
    transition: background 0.15s, border-color 0.15s;
  }

  .icon:hover {
    background: rgba(255, 255, 255, 0.025);
    border-color: var(--border-soft);
    color: inherit;
  }

  .icon.active {
    background: rgba(255, 255, 255, 0.035);
    border-color: var(--border);
  }

  .glyph {
    position: relative;
    display: block;
  }

  .folder-back {
    fill: var(--border);
  }

  .folder-front {
    fill: #2b2b36;
  }

  .icon.active .folder-back,
  .icon:hover .folder-back {
    fill: var(--accent-line);
  }

  .icon.active .folder-front,
  .icon:hover .folder-front {
    fill: var(--accent);
  }

  .count {
    position: absolute;
    right: 6px;
    bottom: 3px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--bg);
  }

  .icon:not(.active) .count {
    color: var(--text-muted);
  }

  .label {
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .icon.active .label {
    color: var(--accent);
  }

  /* Scope sits under the icon like file metadata on a real desktop.
     This is what a recruiter reads before clicking anything. */
  .caption {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.45;
    color: var(--text-faint);
  }

  /* Phone: home screen, not a shrunken desktop. */
  @media (max-width: 760px) {
    .icons {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--s1);
      padding-bottom: var(--s3);
    }

    .icon {
      padding: var(--s2) var(--s1);
    }

    .caption {
      font-size: 0.64rem;
    }
  }
</style>
