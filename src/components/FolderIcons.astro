---
import { folders } from '../data/folders';
import type { FolderId } from '../data/folders';

interface Props {
  active?: FolderId;
}

const { active } = Astro.props;
---

<nav class="icons chrome" aria-label="Folders">
  {
    folders.map((f) => (
      <a
        href={`/${f.id}`}
        class:list={['icon', { on: f.id === active }]}
        aria-current={f.id === active ? 'page' : undefined}
      >
        <span class="folder" aria-hidden="true" />
        <span class="label">{f.label}</span>
      </a>
    ))
  }

  <button type="button" class="icon help" aria-label="Ask about Tia's experience" disabled>
    <span class="sheet" aria-hidden="true">?</span>
    <span class="label">Ask</span>
  </button>
</nav>

<style>
  .icons {
    display: flex;
    flex-direction: column;
    gap: 34px;
    width: 116px;
  }

  .icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 116px;
    cursor: pointer;
  }

  /* Gold folder with a tab, drawn in bevels rather than an image
     so it stays crisp at any density. */
  .folder {
    position: relative;
    width: 56px;
    height: 45px;
    background: var(--folder);
    border: 1px solid #000;
    box-shadow:
      inset 2px 2px 0 #fff,
      inset -2px -2px 0 var(--folder-dark),
      2px 2px 0 #000;
  }

  .folder::before {
    content: '';
    position: absolute;
    top: -10px;
    left: -1px;
    width: 24px;
    height: 10px;
    background: var(--folder);
    border: 1px solid #000;
    border-bottom: none;
    box-shadow: inset 2px 2px 0 #fff;
  }

  /* A help file, not a folder — the era drew these as a page
     with a turned corner. */
  .help {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    cursor: default;
    opacity: 0.65;
  }

  .sheet {
    position: relative;
    display: grid;
    place-items: center;
    width: 40px;
    height: 48px;
    background: #fff;
    border: 1px solid #000;
    box-shadow: 2px 2px 0 #000;
    font-family: var(--font-ui);
    font-size: 22px;
    font-weight: bold;
    color: var(--select-bg);
  }

  /* The folded corner. */
  .sheet::after {
    content: '';
    position: absolute;
    top: -1px;
    right: -1px;
    border-width: 0 0 11px 11px;
    border-style: solid;
    border-color: transparent transparent var(--ui-bg) transparent;
    box-shadow: -1px 1px 0 #000;
  }

  .label {
    margin-top: 10px;
    font-size: 12px;
    padding: 1px 3px;
    text-align: center;
    line-height: 1.25;
    color: #fff;
    text-shadow: 1px 1px 0 #000;
  }

  /* Period-correct selection: navy fill, dotted marching border. */
  .icon:hover .label,
  .icon:focus-visible .label,
  .icon.on .label {
    background: var(--select-bg);
    border: 1px dotted #fff;
    padding: 0 2px;
    text-shadow: none;
  }

  .icon:hover .folder,
  .icon.on .folder {
    filter: brightness(1.12);
  }

  .icon:active .folder {
    filter: brightness(0.8);
  }

  /* Phone: icons run as a grid across the top, the way a
     home screen does, instead of a left-hand column. */
  @media (max-width: 720px) {
    .icons {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 26px 14px;
      width: 100%;
    }

    .icon {
      width: calc(50% - 10px);
      min-width: 96px;
    }
  }
</style>
