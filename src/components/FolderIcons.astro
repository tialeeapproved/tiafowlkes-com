---
import { folders } from '../data/folders';
import type { FolderId } from '../data/folders';

interface Props {
  /* 'ask' is not a folder — it is the help file beneath them —
     but it can still be the current page. */
  active?: FolderId | 'ask';
}

const { active } = Astro.props;
---

<nav class="icons chrome" aria-label="Folders">
  {
    folders.map((f) => (
      <a
        href={`/${f.id}`}
        class:list={['icon', { on: f.id === active }]}
        aria-current={f.id === active ? 'page' : undefined}
      >
        <span class="folder" aria-hidden="true" />
        <span class="label">{f.label}</span>
      </a>
    ))
  }

  <a
    href="/ask"
    class:list={['icon', 'help', { on: active === 'ask' }]}
    aria-current={active === 'ask' ? 'page' : undefined}
  >
    <span class="sheet" aria-hidden="true">?</span>
    <span class="label">Ask</span>
  </a>
</nav>

<style>
  .icons {
    display: flex;
    flex-direction: column;
    gap: 34px;
    width: 116px;
  }

  .icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 116px;
    cursor: pointer;
  }

  /* Gold folder with a tab, drawn in bevels rather than an image
     so it stays crisp at any density. */
  .folder {
    position: relative;
    width: 56px;
    height: 45px;
    background: var(--folder);
    border: 1px solid #000;
    box-shadow:
      inset 2px 2px 0 #fff,
      inset -2px -2px 0 var(--folder-dark),
      2px 2px 0 #000;
  }

  .folder::before {
    content: '';
    position: absolute;
    top: -10px;
    left: -1px;
    width: 24px;
    height: 10px;
    background: var(--folder);
    border: 1px solid #000;
    border-bottom: none;
    box-shadow: inset 2px 2px 0 #fff;
  }

  /* Not a folder and not a file — just the mark itself, set at
     the same size as a folder icon so the column stays even. */
  .help {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    opacity: 0.75;
  }

  .help:hover,
  .help.on {
    opacity: 1;
  }

  .sheet {
    display: grid;
    place-items: center;
    width: 56px;
    height: 45px;
    font-family: var(--font-ui);
    font-size: 40px;
    font-weight: bold;
    line-height: 1;
    color: #fff;
    text-shadow: 2px 2px 0 #000;
  }

  .label {
    margin-top: 10px;
    font-size: 12px;
    padding: 1px 3px;
    text-align: center;
    line-height: 1.25;
    color: #fff;
    text-shadow: 1px 1px 0 #000;
  }

  /* Period-correct selection: navy fill, dotted marching border. */
  .icon:hover .label,
  .icon:focus-visible .label,
  .icon.on .label {
    background: var(--select-bg);
    border: 1px dotted #fff;
    padding: 0 2px;
    text-shadow: none;
  }

  .icon:hover .folder,
  .icon.on .folder {
    filter: brightness(1.12);
  }

  .icon:active .folder {
    filter: brightness(0.8);
  }

  /* Tablet and phone: icons run across the top the way a home
     screen does, instead of a left-hand column. This breakpoint
     must match the one in Page.astro that takes the rail out of
     `position: fixed` — otherwise the column stands upright inside
     a horizontal strip and eats the viewport. */
  @media (max-width: 900px) {
    .icons {
      flex-direction: row;
      flex-wrap: nowrap;
      justify-content: flex-start;
      gap: 6px;
      width: 100%;
    }

    .icon {
      flex: 1 1 0;
      width: auto;
      min-width: 0;
    }

    .folder,
    .sheet {
      width: 44px;
      height: 36px;
    }

    .folder::before {
      top: -8px;
      width: 19px;
      height: 8px;
    }

    .sheet {
      font-size: 30px;
    }

    .label {
      margin-top: 7px;
      font-size: 11px;
    }
  }

  @media (max-width: 480px) {
    .icons {
      gap: 2px;
    }

    .folder,
    .sheet {
      width: 36px;
      height: 29px;
    }

    .folder::before {
      top: -7px;
      width: 16px;
      height: 7px;
    }

    .sheet {
      font-size: 24px;
    }

    .label {
      margin-top: 6px;
      font-size: 10px;
      letter-spacing: -0.01em;
    }
  }
</style>
