---
interface Props {
  title: string;
  subtitle?: string;
  path?: string;
}

const { title, subtitle, path } = Astro.props;
---

<section class="window" id="main">
  <div class="titlebar">
    <span class="dots" aria-hidden="true">
      <i></i><i></i><i></i>
    </span>
    <span class="title">{title}</span>
    {path && <span class="path mono">{path}</span>}
  </div>

  <div class="body">
    {subtitle && <p class="subtitle">{subtitle}</p>}
    <slot />
  </div>
</section>

<style>
  .window {
    border: 1px solid var(--border);
    border-radius: var(--radius-window);
    background: var(--window);
    overflow: hidden;
    margin-bottom: var(--s6);
  }

  .titlebar {
    display: flex;
    align-items: center;
    gap: var(--s2);
    padding: 0.6rem var(--s2);
    background: var(--window-bar);
    border-bottom: 1px solid var(--border);
  }

  .dots {
    display: flex;
    gap: 6px;
  }

  .dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--border);
  }

  .dots i:first-child {
    background: #35353f;
  }

  .title {
    font-family: var(--font-display);
    font-size: 0.86rem;
    font-weight: 600;
  }

  .path {
    margin-left: auto;
    font-size: 0.68rem;
  }

  .body {
    padding: var(--s3);
  }

  .subtitle {
    max-width: var(--measure);
    margin-bottom: var(--s3);
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  @media (max-width: 760px) {
    .window {
      border-radius: var(--radius);
    }

    .body {
      padding: var(--s2);
    }

    .path {
      display: none;
    }
  }
</style>
