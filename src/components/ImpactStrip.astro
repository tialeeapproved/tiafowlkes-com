---
import { impact } from '../data/site';
---

<div class="strip" role="list" aria-label="Impact at a glance">
  {
    impact.map((item) => (
      <span class="item" role="listitem">
        {item}
      </span>
    ))
  }
</div>

<style>
  .strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0;
    padding: var(--s4) 0 var(--s3);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .item {
    white-space: nowrap;
  }

  .item + .item::before {
    content: '·';
    margin: 0 0.7rem;
    color: var(--accent);
  }

  @media (max-width: 700px) {
    .strip {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.3rem;
      padding-top: var(--s3);
      font-size: 0.74rem;
    }

    .item + .item::before {
      display: none;
    }
  }
</style>
