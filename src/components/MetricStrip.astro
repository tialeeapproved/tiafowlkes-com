---
/* Load-bearing. A recruiter reads these before any prose, so
   they sit as their own row of glass chips in the mono face —
   the readout, separated from the argument. */

interface Props {
  metrics: string[];
}

const { metrics } = Astro.props;
---

<div class="strip">
  {metrics.map((m) => <span class="chip">{m}</span>)}
</div>

<style>
  .strip {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 24px;
  }

  .chip {
    padding: 7px 14px;
    /* Tinted rather than white: the cards these sit on are themselves
       near-opaque white, and a white chip on white is not a chip. */
    border: 1px solid rgba(16, 23, 30, 0.09);
    border-radius: 100px;
    background: rgba(16, 23, 30, 0.045);
    font-family: var(--g-mono);
    font-size: 12px;
    /* The readout carries the section, so it is set heavier than
       anything around it — the eye should land here first. */
    font-weight: 600;
    line-height: 1.4;
    color: var(--g-text);
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    .chip {
      font-size: 11px;
      padding: 6px 11px;
      white-space: normal;
    }
  }
</style>
