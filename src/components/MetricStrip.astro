---
/* Load-bearing. A recruiter reads these before any prose, so
   they sit as their own row of glass chips in the mono face —
   the readout, separated from the argument. */

interface Props {
  metrics: string[];
}

const { metrics } = Astro.props;
---

<div class="strip">
  {metrics.map((m) => <span class="chip">{m}</span>)}
</div>

<style>
  .strip {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 24px;
  }

  .chip {
    padding: 7px 14px;
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.42);
    font-family: var(--g-mono);
    font-size: 12px;
    line-height: 1.4;
    color: var(--g-text);
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    .chip {
      font-size: 11px;
      padding: 6px 11px;
      white-space: normal;
    }
  }
</style>
