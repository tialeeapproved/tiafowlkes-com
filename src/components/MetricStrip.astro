---
/* Load-bearing. A recruiter reads these before any prose, so
   they get the treatment of a real dialog readout: white sunken
   wells in a row, the way the Levels inputs sit. */

interface Props {
  metrics: string[];
}

const { metrics } = Astro.props;
---

<div class="strip">
  {
    metrics.map((m) => (
      <span class="well sunken">{m}</span>
    ))
  }
</div>

<style>
  .strip {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s1);
    margin-bottom: var(--s3);
  }

  .well {
    flex: 1 1 auto;
    min-width: 130px;
    padding: 5px 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.4;
    color: var(--ui-text);
    text-align: center;
  }

  @media (max-width: 620px) {
    .well {
      flex: 1 1 100%;
      text-align: left;
    }
  }
</style>
