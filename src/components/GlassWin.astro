---
/* A frosted window fixed to the size of the viewport. The window
   itself never moves or resizes — its contents scroll inside it,
   so the gap around all four edges is always there and the page
   never reads as a long column. */

interface Props {
  title: string;
  close?: string;
}

const { title, close = '/' } = Astro.props;
---

<section class="win">
  <header class="bar">
    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="title">{title}</span>
    <a class="close" href={close} aria-label="Close window">
      <span aria-hidden="true"></span>
    </a>
  </header>

  <div class="body">
    <slot />
  </div>
</section>

<style>
  .win {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    /* Safe to clip again now that the scroll container is .body
       rather than the page — the corners stay round and nothing
       escapes them. */
    overflow: hidden;
    border: 1px solid var(--g-border);
    border-radius: var(--r-lg);
    background: var(--g-panel);
    backdrop-filter: var(--blur) saturate(1.4);
    -webkit-backdrop-filter: var(--blur) saturate(1.4);
    box-shadow:
      0 28px 60px -18px rgba(12, 30, 50, 0.45),
      0 2px 8px rgba(12, 30, 50, 0.12),
      inset 0 1px 0 0 var(--g-highlight);
  }

  /* The lit corner that sells the material. */
  .win::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    border-radius: inherit;
    background: radial-gradient(
      circle at 18% 0%,
      rgba(255, 255, 255, 0.55) 0%,
      transparent 55%
    );
  }

  /* Chrome. Sits outside the scroll area, so it is simply always
     there — no pinning needed. */
  .bar {
    position: relative;
    z-index: 2;
    flex: none;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 13px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.6);
    background: rgba(233, 241, 252, 0.7);
  }

  .dots {
    display: flex;
    gap: 6px;
  }

  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(16, 23, 30, 0.14);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.6);
  }

  .title {
    font-family: var(--g-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--g-text-2);
  }

  .close {
    position: relative;
    width: 22px;
    height: 22px;
    margin-left: auto;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.4);
    transition: background 0.18s;
  }

  .close:hover {
    background: rgba(255, 255, 255, 0.85);
  }

  .close span::before,
  .close span::after {
    content: '';
    position: absolute;
    top: 10px;
    left: 6px;
    width: 10px;
    height: 1.5px;
    border-radius: 1px;
    background: var(--g-text-2);
  }

  .close span::before {
    transform: rotate(45deg);
  }

  .close span::after {
    transform: rotate(-45deg);
  }

  /* THE scroll container. Everything scrolls in here, not on the
     page — which is what keeps the frame still and the gap
     constant at the top and the bottom. */
  .body {
    position: relative;
    z-index: 1;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 38px 40px 42px;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .body::-webkit-scrollbar {
    width: 0;
    height: 0;
  }

  @media (max-width: 720px) {
    .win {
      border-radius: var(--r-md);
    }

    .bar {
      padding: 11px 13px;
    }

    .body {
      padding: 24px 20px 28px;
    }
  }
</style>
