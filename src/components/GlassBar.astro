---
import { site } from '../data/site';
import { folders } from '../data/folders';
import type { FolderId } from '../data/folders';

interface Props {
  active: FolderId;
}

const { active } = Astro.props;
---

<header class="bar glass">
  <a href="/" class="brand">
    <span class="mark" aria-hidden="true"></span>
    {site.name}
  </a>

  <nav class="links" aria-label="Pages">
    {
      folders.map((f) => (
        <a
          href={`/${f.id}`}
          class:list={['link', { on: f.id === active }]}
          aria-current={f.id === active ? 'page' : undefined}
        >
          {f.label}
        </a>
      ))
    }
  </nav>

  <a href={site.resume} class="resume">Résumé</a>
</header>

<style>
  .bar {
    position: sticky;
    top: 16px;
    z-index: 100;
    display: flex;
    align-items: center;
    gap: 28px;
    width: fit-content;
    max-width: 100%;
    margin: 16px auto 0;
    padding: 8px 10px 8px 18px;
    border-radius: 100px;
    font-size: 12px;
    letter-spacing: 0.04em;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    font-weight: 500;
    color: var(--g-text);
    white-space: nowrap;
  }

  /* A small lit square standing in for a system mark. */
  .mark {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.85),
      rgba(255, 255, 255, 0.25)
    );
  }

  .links {
    display: flex;
    align-items: center;
    gap: 4px;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .links::-webkit-scrollbar {
    display: none;
  }

  .link {
    padding: 5px 12px;
    border-radius: 100px;
    color: var(--g-text-2);
    white-space: nowrap;
    transition: background 0.2s, color 0.2s;
  }

  .link:hover {
    background: var(--g-hover);
    color: var(--g-text);
  }

  .link.on {
    background: rgba(255, 255, 255, 0.1);
    color: var(--g-text);
  }

  .resume {
    padding: 5px 14px;
    border: 1px solid var(--g-border);
    border-radius: 100px;
    color: var(--g-text-2);
    white-space: nowrap;
    transition: background 0.2s, color 0.2s;
  }

  .resume:hover {
    background: var(--g-hover);
    color: var(--g-text);
  }

  @media (max-width: 820px) {
    .bar {
      gap: 14px;
      width: calc(100% - 24px);
      margin: 12px auto 0;
      padding: 8px 8px 8px 14px;
      border-radius: var(--r-md);
    }

    .brand {
      font-size: 12px;
    }

    .link {
      padding: 5px 9px;
    }
  }

  @media (max-width: 560px) {
    .bar {
      flex-wrap: wrap;
      justify-content: space-between;
    }

    .links {
      order: 3;
      width: 100%;
      padding-top: 4px;
      border-top: 1px solid var(--g-border-soft);
    }
  }
</style>
