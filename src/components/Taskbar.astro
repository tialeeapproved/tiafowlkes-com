---
import { site } from '../data/site';
---

<footer class="taskbar chrome">
  <a href="/" class="name">{site.name}</a>

  <div class="tray">
    <button type="button" class="btn" aria-label="Ask about Tia's experience" disabled>?</button>
    <a href={site.resume} class="btn">Résumé</a>
  </div>
</footer>

<style>
  .taskbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s2);
    height: var(--taskbar-h);
    padding: 2px var(--s1);
    background: var(--ui-bg);
    border-top: 2px solid var(--ui-highlight);
  }

  .name,
  .btn {
    display: flex;
    align-items: center;
    height: 22px;
    padding: 0 12px;
    background: var(--ui-bg);
    border-top: 2px solid var(--ui-highlight);
    border-left: 2px solid var(--ui-highlight);
    border-right: 2px solid var(--ui-dark-shadow);
    border-bottom: 2px solid var(--ui-dark-shadow);
    box-shadow: inset -1px -1px 0 var(--ui-shadow);
    color: var(--ui-text);
    white-space: nowrap;
    cursor: pointer;
  }

  .name {
    font-weight: bold;
  }

  .name:active,
  .btn:active {
    border-top-color: var(--ui-dark-shadow);
    border-left-color: var(--ui-dark-shadow);
    border-right-color: var(--ui-highlight);
    border-bottom-color: var(--ui-highlight);
    box-shadow: inset 1px 1px 0 var(--ui-shadow);
  }

  .tray {
    display: flex;
    gap: 3px;
    padding-left: var(--s1);
    border-left: 1px solid var(--ui-shadow);
  }

  .btn:disabled {
    color: var(--ui-shadow);
    cursor: default;
  }
</style>
