---
import { site } from '../data/site';
---

<footer class="taskbar chrome">
  <div class="start">
    <a href="/" class="name">{site.name}</a>
    <p class="facts">
      {site.facts.map((f) => <span>{f}</span>)}
    </p>
  </div>

  <div class="tray">
    <a href={site.resume} class="btn">Résumé</a>
  </div>
</footer>

<style>
  .taskbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s2);
    height: var(--taskbar-h);
    /* Enough inset that the buttons' outer bevels are not clipped
       by the edge of the screen. */
    padding: 3px 8px;
    background: var(--ui-bg);
    border-top: 2px solid var(--ui-highlight);
  }

  .start {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  /* Plain text, deliberately — these are facts, not destinations, so
     they get no bevel and nothing to click. */
  .facts {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-left: 12px;
    color: var(--ui-text);
    white-space: nowrap;
    overflow: hidden;
  }

  .facts span + span::before {
    content: '·';
    margin-right: 10px;
  }

  .name,
  .btn {
    display: flex;
    align-items: center;
    height: 22px;
    padding: 0 12px;
    background: var(--ui-bg);
    border-top: 2px solid var(--ui-highlight);
    border-left: 2px solid var(--ui-highlight);
    border-right: 2px solid var(--ui-dark-shadow);
    border-bottom: 2px solid var(--ui-dark-shadow);
    box-shadow: inset -1px -1px 0 var(--ui-shadow);
    color: var(--ui-text);
    white-space: nowrap;
    cursor: pointer;
  }

  .name {
    font-weight: bold;
  }

  .name:active,
  .btn:active {
    border-top-color: var(--ui-dark-shadow);
    border-left-color: var(--ui-dark-shadow);
    border-right-color: var(--ui-highlight);
    border-bottom-color: var(--ui-highlight);
    box-shadow: inset 1px 1px 0 var(--ui-shadow);
  }

  .tray {
    display: flex;
    gap: 3px;
    padding-left: var(--s1);
    border-left: 1px solid var(--ui-shadow);
  }

  .btn:disabled {
    color: var(--ui-shadow);
    cursor: default;
  }

  /* On a phone the bar only has room for the name. */
  @media (max-width: 720px) {
    .facts {
      display: none;
    }
  }
</style>
