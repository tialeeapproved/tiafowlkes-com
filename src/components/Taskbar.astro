---
import { site } from '../data/site';
---

<footer class="taskbar chrome">
  <div class="start">
    <a href="/" class="name">{site.name}</a>
    <p class="facts">
      {site.facts.map((f) => <span>{f}</span>)}
    </p>
  </div>

  <div class="tray">
    <a href={site.resume} class="btn" target="_blank" rel="noopener">Resume</a>
  </div>
</footer>

<style>
  .taskbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s2);
    height: var(--taskbar-h);
    /* The raised buttons carry an outer bevel outside their box; at
       8px the viewport edge clipped it. */
    padding: 4px 12px;
    background: var(--ui-bg);
    border-top: 2px solid var(--ui-highlight);
  }

  .start {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  /* Plain text, deliberately — these are facts, not destinations, so
     they get no bevel and nothing to click. */
  .facts {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-left: 14px;
    /* Tahoma sets tightly at this size — "Technical" ran its `a` and
       `l` together. A hair of tracking separates them. */
    font-size: 11.5px;
    letter-spacing: 0.02em;
    color: var(--ui-text);
    white-space: nowrap;
    overflow: hidden;
  }

  .facts span + span::before {
    content: '·';
    margin-right: 10px;
  }

  .name,
  .btn {
    display: flex;
    align-items: center;
    height: 22px;
    padding: 0 12px;
    background: var(--ui-bg);
    border-top: 2px solid var(--ui-highlight);
    border-left: 2px solid var(--ui-highlight);
    border-right: 2px solid var(--ui-dark-shadow);
    border-bottom: 2px solid var(--ui-dark-shadow);
    box-shadow: inset -1px -1px 0 var(--ui-shadow);
    color: var(--ui-text);
    white-space: nowrap;
    cursor: pointer;
  }

  .name {
    font-weight: bold;
  }

  .name:active,
  .btn:active {
    border-top-color: var(--ui-dark-shadow);
    border-left-color: var(--ui-dark-shadow);
    border-right-color: var(--ui-highlight);
    border-bottom-color: var(--ui-highlight);
    box-shadow: inset 1px 1px 0 var(--ui-shadow);
  }

  .tray {
    display: flex;
    gap: 3px;
    padding-left: var(--s1);
    border-left: 1px solid var(--ui-shadow);
  }

  .btn:disabled {
    color: var(--ui-shadow);
    cursor: default;
  }

  /* ---- phone ----
     The bar has room for one fact, not three. Rather than dropping
     them, they take turns in the same slot: each holds for about six
     seconds, so a reader who glances twice sees two different facts and
     one who stays sees all three. Stacked absolutely so the bar never
     changes width as they swap — a taskbar that reflows every six
     seconds would be worse than showing nothing. */
  @media (max-width: 720px) {
    /* `.start` is content-sized by default, so a `flex: 1` on `.facts`
       alone resolves against a zero basis and the text renders at no
       width at all — present in the DOM, fully opaque, invisible. The
       grow has to start here. */
    .start {
      flex: 1;
      min-width: 0;
    }

    .facts {
      position: relative;
      display: block;
      flex: 1;
      min-width: 0;
      height: 15px;
      padding-left: 10px;
      font-size: 11px;
    }

    .facts span {
      position: absolute;
      top: 0;
      left: 10px;
      right: 0;
      opacity: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      animation: fact-cycle 18s infinite;
    }

    /* Each waits out the two before it. */
    .facts span:nth-child(2) {
      animation-delay: 6s;
    }

    .facts span:nth-child(3) {
      animation-delay: 12s;
    }

    /* The separator belongs to a row, and this is not one. */
    .facts span + span::before {
      content: none;
    }
  }

  /* 18s cycle, three facts: about a second to fade, five to hold. */
  @keyframes fact-cycle {
    0%,
    1% {
      opacity: 0;
    }
    5%,
    30% {
      opacity: 1;
    }
    34%,
    100% {
      opacity: 0;
    }
  }

  /* Rotating text is motion. Reduced-motion readers get the first
     fact, held still. */
  @media (prefers-reduced-motion: reduce) {
    .facts span {
      animation: none;
    }

    .facts span:first-child {
      opacity: 1;
    }

    .facts span:not(:first-child) {
      opacity: 0;
    }
  }
</style>
