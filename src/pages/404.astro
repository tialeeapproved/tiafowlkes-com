---
import Base from '../layouts/Base.astro';
import Sky from '../components/Sky.astro';
import Taskbar from '../components/Taskbar.astro';
import Win from '../components/Win.astro';
---

<Base title="Not found">
  <Sky />

  <main class="stage" id="main">
    <div class="dialog">
      <Win title="Error">
        <div class="row">
          <span class="bang" aria-hidden="true">!</span>
          <div>
            <p>That file cannot be found on this desktop.</p>
            <p class="hint">It may have been moved, renamed, or it never existed.</p>
          </div>
        </div>

        <div class="actions">
          <a href="/" class="btn">OK</a>
        </div>
      </Win>
    </div>
  </main>

  <Taskbar />
</Base>

<style>
  .stage {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - var(--taskbar-h));
    padding: 20px;
  }

  .dialog {
    width: 100%;
    max-width: 420px;
  }

  .row {
    display: flex;
    align-items: flex-start;
    gap: var(--s3);
  }

  .bang {
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--select-bg);
    color: #fff;
    font-size: 20px;
    font-weight: bold;
    line-height: 30px;
    text-align: center;
  }

  p {
    font-size: var(--size-body);
  }

  .hint {
    margin-top: 4px;
    font-size: 12px;
    color: #444;
  }

  .actions {
    display: flex;
    justify-content: center;
    margin-top: var(--s4);
  }

  .btn {
    min-width: 84px;
    padding: 4px 14px;
    text-align: center;
    background: var(--ui-bg);
    border-top: 2px solid var(--ui-highlight);
    border-left: 2px solid var(--ui-highlight);
    border-right: 2px solid var(--ui-dark-shadow);
    border-bottom: 2px solid var(--ui-dark-shadow);
    box-shadow: inset -1px -1px 0 var(--ui-shadow);
    font-size: var(--size-ui);
  }

  .btn:active {
    border-top-color: var(--ui-dark-shadow);
    border-left-color: var(--ui-dark-shadow);
    border-right-color: var(--ui-highlight);
    border-bottom-color: var(--ui-highlight);
    box-shadow: inset 1px 1px 0 var(--ui-shadow);
  }
</style>
