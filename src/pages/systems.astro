---
import Page from '../layouts/Page.astro';
import { systemsLead, systems, systemsClosing } from '../data/systems';
---

<Page active="systems" lead={systemsLead} wide>
  <ol class="grid">
    {
      systems.map((s) => (
        <li class="tile raised">
          <span class="n" aria-hidden="true">
            {String(s.n).padStart(2, '0')}
          </span>
          <h2>{s.name}</h2>
          <p class="served">{s.served}</p>
          <p class="changed">{s.changed}</p>
        </li>
      ))
    }
  </ol>

  <p class="closing">{systemsClosing}</p>
</Page>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s3);
  }

  .tile {
    padding: var(--s3);
  }

  /* The only numerals on the site. These six are an inventory,
     which is what earns them. Set in the mono face and sunken
     like a readout. */
  .n {
    display: inline-block;
    margin-bottom: var(--s2);
    padding: 1px 7px;
    background: var(--select-bg);
    color: var(--select-text);
    font-family: var(--font-mono);
    font-size: 15px;
    line-height: 1.3;
  }

  h2 {
    margin-bottom: var(--s2);
    font-size: 14px;
    font-weight: bold;
    line-height: 1.35;
  }

  .served,
  .changed {
    font-size: 13px;
    line-height: 1.55;
  }

  .served {
    margin-bottom: 6px;
    color: #444;
  }

  .closing {
    max-width: var(--measure);
    margin-top: var(--s6);
    padding-top: var(--s3);
    border-top: 1px solid var(--ui-shadow);
    box-shadow: 0 -1px 0 var(--ui-highlight) inset;
    font-size: 13px;
    line-height: 1.6;
    color: #333;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
