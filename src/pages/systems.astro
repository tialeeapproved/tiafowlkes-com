---
import Page from '../layouts/Page.astro';
import { systemsLead, systems, systemsClosing } from '../data/systems';
---

<Page active="systems" lead={systemsLead}>
  <ol class="grid">
    {
      systems.map((s) => (
        <li class="tile">
          <span class="n" aria-hidden="true">
            {String(s.n).padStart(2, '0')}
          </span>
          <h2>{s.name}</h2>
          <p class="served">{s.served}</p>
          <p class="changed">{s.changed}</p>
        </li>
      ))
    }
  </ol>

  <p class="closing">{systemsClosing}</p>
</Page>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }

  .tile {
    position: relative;
    padding: var(--s3);
    background: var(--window);
  }

  /* The only numerals on the site. These six are an inventory,
     which is what earns them. */
  .n {
    display: block;
    margin-bottom: var(--s2);
    font-family: var(--font-mono);
    font-size: 1.6rem;
    font-weight: 500;
    line-height: 1;
    color: var(--accent);
  }

  .tile h2 {
    margin-bottom: var(--s2);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .served,
  .changed {
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .served {
    margin-bottom: 0.5rem;
    color: var(--text-faint);
  }

  .changed {
    color: var(--text-muted);
  }

  .closing {
    max-width: var(--measure);
    padding-top: var(--s4);
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--text-faint);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
