---
import Glass from '../layouts/Glass.astro';
import { systemsLead, systems, systemsClosing } from '../data/systems';
---

<Glass active="systems" lead={systemsLead}>
  <ol class="grid">
    {
      systems.map((s) => (
        <li class="tile glass">
          <span class="n" aria-hidden="true">
            {String(s.n).padStart(2, '0')}
          </span>
          <h2>{s.name}</h2>
          <p class="served">{s.served}</p>
          <p class="changed">{s.changed}</p>
        </li>
      ))
    }
  </ol>

  <p class="closing">{systemsClosing}</p>
</Glass>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .tile {
    display: flex;
    flex-direction: column;
    padding: 28px 26px;
    border-radius: var(--r-md);
  }

  /* The only numerals on the site. These six are an inventory,
     which is what earns them. Set large and low-contrast so they
     order the grid without shouting. */
  .n {
    display: block;
    margin-bottom: 20px;
    font-family: var(--g-mono);
    font-size: 30px;
    font-weight: 400;
    line-height: 1;
    color: rgba(255, 255, 255, 0.22);
  }

  h2 {
    margin-bottom: 14px;
    font-size: 16px;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.35;
    color: var(--g-text);
  }

  .served,
  .changed {
    font-size: 13px;
    line-height: 1.6;
  }

  .served {
    margin-bottom: 10px;
    color: var(--g-text-3);
  }

  .changed {
    color: var(--g-text-2);
  }

  .closing {
    max-width: 76ch;
    margin-top: 34px;
    padding-top: 26px;
    border-top: 1px solid var(--g-border-soft);
    font-size: 13px;
    font-weight: 300;
    line-height: 1.7;
    color: var(--g-text-3);
  }

  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 660px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .tile {
      padding: 22px 20px;
    }
  }
</style>
