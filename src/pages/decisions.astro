---
import { getCollection } from 'astro:content';
import Page from '../layouts/Page.astro';

const entries = (await getCollection('decisions', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const lead =
  'A resume records program execution. This log documents strategic judgment. Eight pivotal program calls made under incomplete information, competing cross-functional priorities, and immovable launch windows.';
---

<Page active="decisions" lead={lead}>
  <div class="log stack">
    {
      entries.map((entry, i) => (
        <div class="slot">
        <article class="entry pane pop" id={entry.id.replace(/^\d+-/, '')}>
          <header class="head">
            <span class="meta idx">{String(i + 1).padStart(2, '0')}</span>
            <h2>{entry.data.headline}</h2>
          </header>

          <div class="blocks">
            <div class="block">
              <p class="label">Context</p>
              <p>{entry.data.context}</p>
            </div>
            <div class="block">
              <p class="label">The call</p>
              <p>{entry.data.call}</p>
            </div>
            <div class="block">
              <p class="label">What followed</p>
              <p>{entry.data.followed}</p>
            </div>
          </div>
        </article>
        </div>
      ))
    }
  </div>
</Page>

<style>

  .entry {
    padding: 34px;
  }

  .head {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding-bottom: 26px;
    margin-bottom: 26px;
    border-bottom: 1px solid var(--g-border-soft);
  }

  /* The index is orientation, not a ranking — kept in mono at
     tertiary weight so it never competes with the headline. */
  .idx {
    flex: none;
    padding-top: 0;
  }

  h2 {
    /* No measure cap — the headline uses the card's full width so
       phrases don't break early and land mid-thought. */
    font-size: clamp(20px, 2.4vw, 27px);
    text-wrap: balance;
    font-weight: 300;
    letter-spacing: -0.025em;
    line-height: 1.2;
    color: var(--g-text);
  }

  .blocks {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }

  .block .label {
    margin-bottom: 10px;
  }

  .block p:last-child {
    font-size: 14px;
    line-height: 1.65;
    color: var(--g-text-2);
  }

  @media (max-width: 900px) {
    .blocks {
      grid-template-columns: 1fr;
      gap: 22px;
    }
  }

  @media (max-width: 720px) {
    .entry {
      padding: 24px 20px;
      border-radius: var(--r-md);
    }

    .head {
      gap: 12px;
      padding-bottom: 20px;
      margin-bottom: 20px;
    }
  }
</style>
