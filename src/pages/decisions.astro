---
import { getCollection } from 'astro:content';
import Page from '../layouts/Page.astro';
import Fieldset from '../components/Fieldset.astro';

const entries = (await getCollection('decisions', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const lead =
  'A resume records program execution. This log documents strategic judgment. Eight pivotal program calls made under incomplete information, competing cross-functional priorities, and immovable launch windows.';
---

<Page active="decisions" lead={lead} wide>
  <div class="log">
    {
      entries.map((entry) => (
        <article class="entry" id={entry.id.replace(/^\d+-/, '')}>
          <h2>{entry.data.headline}</h2>

          <div class="blocks">
            <Fieldset legend="Context">
              <p>{entry.data.context}</p>
            </Fieldset>
            <Fieldset legend="The call">
              <p>{entry.data.call}</p>
            </Fieldset>
            <Fieldset legend="What followed">
              <p>{entry.data.followed}</p>
            </Fieldset>
          </div>
        </article>
      ))
    }
  </div>
</Page>

<style>
  .entry {
    padding-bottom: var(--s6);
    margin-bottom: var(--s6);
    /* The era's divider: a groove, not a hairline. */
    border-bottom: 1px solid var(--ui-shadow);
    box-shadow: 0 1px 0 var(--ui-highlight);
  }

  .entry:last-child {
    padding-bottom: 0;
    margin-bottom: 0;
    border-bottom: none;
    box-shadow: none;
  }

  h2 {
    max-width: 34ch;
    margin-bottom: var(--s2);
    font-size: 19px;
    font-weight: bold;
    line-height: 1.3;
  }

  .blocks {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s3);
  }

  .blocks p {
    font-size: var(--size-body);
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .blocks {
      grid-template-columns: 1fr;
      gap: var(--s2);
    }
  }

  @media (max-width: 720px) {
    h2 {
      font-size: 17px;
    }
  }
</style>
