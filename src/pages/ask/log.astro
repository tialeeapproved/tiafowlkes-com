---
/* The question log. Not linked from anywhere and gated on a secret,
   because an open URL here is a public list of who has been looking
   at Tia. Set ASK_LOG_KEY in Vercel and open /ask/log?key=<that>. */
import Base from '../../layouts/Base.astro';
import { readLog, storeReady } from '../../lib/store';

export const prerender = false;

const expected = (import.meta.env.ASK_LOG_KEY ?? process.env.ASK_LOG_KEY ?? '').trim();
const raw = (Astro.url.searchParams.get('key') ?? '').trim();

/* A random key is usually base64, and base64 contains `+`. In a query
   string `+` is the legacy encoding for a space, so `?key=a+b` arrives
   here as `a b` and the comparison fails on a key that is actually
   correct. Rather than making her percent-encode by hand every time,
   accept the space-for-plus reading as well.

   Both sides are trimmed too: pasting into Vercel's env var field
   picks up a trailing newline more often than you would think, and a
   key that is right apart from an invisible character is the most
   annoying possible failure. */
const given = [raw, raw.replace(/ /g, '+')];
const ok = Boolean(expected) && given.includes(expected);

/* Diagnostic for a mismatch. Lengths and a character-class summary only —
   never the values, and never enough to reconstruct either one. It is here
   because "wrong key" and "right key mangled in transit" render identically,
   and guessing between them from the outside wasted several rounds.

   Equal lengths that still do not match means the two strings are genuinely
   different. A short `given` means the URL truncated it — `#` ends a query,
   and `&` starts a new parameter, so a key containing either arrives cut off. */
const classes = (s: string) =>
  [
    /[A-Za-z]/.test(s) ? 'letters' : null,
    /[0-9]/.test(s) ? 'digits' : null,
    /[+/=]/.test(s) ? 'base64 punctuation' : null,
    /[^A-Za-z0-9+/=]/.test(s) ? 'other characters' : null,
  ]
    .filter(Boolean)
    .join(', ') || 'empty';

const diagnosis = !ok && raw
  ? {
      expectedLen: expected.length,
      givenLen: raw.length,
      expectedClasses: classes(expected),
      givenClasses: classes(raw),
      truncated: raw.length > 0 && raw.length < expected.length,
      sameLength: raw.length === expected.length,
    }
  : null;

const entries = ok ? await readLog() : [];
const fmt = (iso: string) =>
  new Date(iso).toLocaleString('en-US', {
    month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit',
  });
---

<Base title="Ask log" fonts>
  <main class="wrap">
    {
      !ok ? (
        <div class="gate">
          <h1>Not found.</h1>
          {/* Distinguishing "no key configured" from "wrong key" gives
              away nothing — a deployment with no key set is not
              protecting anything in the first place, and without this
              both cases render the same page and there is no way to
              tell them apart from outside. */}
          <p>
            {expected
              ? 'That key does not match.'
              : 'ASK_LOG_KEY is not set on this deployment, so there is nothing to check the key against. Add it in Vercel and redeploy.'}
          </p>

          {diagnosis && (
            <dl class="diag">
              <div>
                <dt>Key in Vercel</dt>
                <dd>
                  {diagnosis.expectedLen} characters — {diagnosis.expectedClasses}
                </dd>
              </div>
              <div>
                <dt>Key in your URL</dt>
                <dd>
                  {diagnosis.givenLen} characters — {diagnosis.givenClasses}
                </dd>
              </div>
              <div>
                <dt>Reading</dt>
                <dd>
                  {diagnosis.truncated
                    ? 'Your URL is shorter than the stored key, so it is being cut off in transit. A key containing # or & will do this: # ends the query and & starts a new parameter. Percent-encode them as %23 and %26.'
                    : diagnosis.sameLength
                      ? 'Same length, different content — these are two different strings, not one mangled string. The value in Vercel is not the one you are pasting.'
                      : 'Your URL is longer than the stored key, so something extra is coming along — usually a quote mark or a stray character copied with it.'}
                </dd>
              </div>
            </dl>
          )}
          <p class="diag-note">
            Lengths and character classes only. Neither key is shown.
          </p>
        </div>
      ) : (
        <>
          <header>
            <h1>What people are asking</h1>
            <p class="meta">
              {entries.length} question{entries.length === 1 ? '' : 's'}
              {storeReady ? '' : ' — no store connected, so nothing is being recorded'}
              . Questions only, kept 30 days, last 500. Nothing here identifies anyone.
            </p>
          </header>

          {entries.length === 0 ? (
            <p class="empty">Nothing yet.</p>
          ) : (
            <ol>
              {entries.map((e) => (
                <li>
                  <p class="when meta">{fmt(e.at)} · message {e.turn}</p>
                  <p class="q">{e.q}</p>
                </li>
              ))}
            </ol>
          )}
        </>
      )
    }
  </main>
</Base>

<style>
  .wrap {
    max-width: 46rem;
    margin: 0 auto;
    padding: 48px 24px 80px;
    font-family: var(--font-body, system-ui), sans-serif;
    color: #10171e;
  }

  /* This used to be one line of pale grey on the blue desktop, which
     read as an empty page rather than as an answer. */
  .gate {
    max-width: 34rem;
    margin-top: 12vh;
    padding: 26px 28px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 18px 40px -22px rgba(12, 30, 50, 0.5);
  }

  .gate h1 {
    margin-bottom: 10px;
  }

  .gate p {
    font-size: 14px;
    line-height: 1.6;
    color: #4a545f;
  }

  .diag {
    margin: 18px 0 14px;
    padding: 14px 16px;
    border-radius: 8px;
    background: rgba(16, 23, 30, 0.05);
  }

  .diag div + div {
    margin-top: 10px;
  }

  .diag dt {
    font-family: ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #8892a0;
  }

  .diag dd {
    margin: 2px 0 0;
    font-size: 14px;
    line-height: 1.55;
    color: #253039;
  }

  .diag-note {
    font-size: 12px !important;
    color: #8892a0 !important;
  }

  h1 {
    font-size: 26px;
    font-weight: 300;
    letter-spacing: -0.02em;
  }

  header .meta { margin-top: 8px; }

  .empty { margin-top: 28px; color: #6b7480; }

  ol {
    margin-top: 28px;
    list-style: none;
  }

  li {
    padding: 16px 0;
    border-top: 1px solid rgba(16, 23, 30, 0.1);
  }

  .when { margin-bottom: 6px; }

  .q {
    font-size: 14px;
    line-height: 1.6;
    white-space: pre-wrap;
    color: #253039;
  }

  .meta {
    font-family: ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #8892a0;
  }
</style>
