---
import Page from '../layouts/Page.astro';

const lead =
  "Paste a job description to see how Tia's experience aligns. I'll map her direct accomplishments from her resume and portfolio, and highlight parallel evidence for adjacent skills.";

/* Openers. Each one has a real answer in the knowledge base —
   Programs, Decisions, AI Fluency, and the targeting rules — so
   the first thing a visitor tries never comes back empty. */
const starters = [
  "What's the biggest launch she's owned?",
  'How does she handle risk when the date cannot move?',
  'What has she shipped with AI?',
  'Is she open to roles outside New York?',
];
---

<Page active="ask" title="Ask Tia-GPT" eyebrow="Match a role" lead={lead}>
  <div class="chat pane" id="chat">
    <ol class="thread" id="thread" aria-live="polite" aria-atomic="false">
      <li class="suggest-row" id="suggest">
        {/* One opener at a time, cycling. Clicking asks whichever is
            showing, so the suggestion is also the shortcut. */}
        <button type="button" class="suggest" id="suggest-btn" data-qs={JSON.stringify(starters)}>
          <span id="suggest-text">{starters[0]}</span>
        </button>
      </li>
    </ol>

    <form class="composer" id="composer">
      <label class="sr-only" for="q">Your question</label>
      <textarea
        id="q"
        name="q"
        rows="1"
        maxlength="8000"
        placeholder="Paste a role, or ask a question…"
        autocomplete="off"></textarea>
      <button type="submit" id="send" aria-label="Send">Ask</button>
    </form>

    <p class="foot meta" id="foot">
      All prompts are private and completely unlinked to your identity.
    </p>
  </div>
</Page>

<script>
  const thread = document.getElementById('thread') as HTMLOListElement;
  const form = document.getElementById('composer') as HTMLFormElement;
  const input = document.getElementById('q') as HTMLTextAreaElement;
  const send = document.getElementById('send') as HTMLButtonElement;
  const foot = document.getElementById('foot') as HTMLParagraphElement;
  const suggest = document.getElementById('suggest') as HTMLLIElement | null;
  const suggestBtn = document.getElementById('suggest-btn') as HTMLButtonElement | null;
  const suggestText = document.getElementById('suggest-text') as HTMLSpanElement | null;

  const MAX_TURNS = 12;
  const STORE = 'ask.thread';

  /* The conversation lives in the tab, and travels back up with every
     request — that is how a follow-up knows what it is following up
     on. sessionStorage only stops a refresh from wiping it. */
  let messages: { role: 'user' | 'assistant'; content: string }[] = [];
  try {
    messages = JSON.parse(sessionStorage.getItem(STORE) ?? '[]');
  } catch {}

  const save = () => {
    try {
      sessionStorage.setItem(STORE, JSON.stringify(messages));
    } catch {}
  };

  /* The bot writes **bold** to mark the load-bearing terms. Render it
     by building nodes — never innerHTML — so a stray angle bracket in
     a pasted job description can never become markup. */
  function render(el: HTMLElement, text: string) {
    el.textContent = '';
    const parts = text.split(/\*\*([^*]+)\*\*/g);
    parts.forEach((part, i) => {
      if (!part) return;
      if (i % 2 === 1) {
        const b = document.createElement('strong');
        b.textContent = part;
        el.append(b);
      } else {
        el.append(document.createTextNode(part));
      }
    });
  }

  function bubble(role: 'user' | 'bot', text: string) {
    const li = document.createElement('li');
    li.className = `msg ${role}`;
    const p = document.createElement('p');
    if (role === 'bot') render(p, text);
    else p.textContent = text;
    li.append(p);
    thread.append(li);
    li.scrollIntoView({ block: 'end', behavior: 'smooth' });
    return p;
  }

  /* Replay anything the tab already had. */
  for (const m of messages) bubble(m.role === 'user' ? 'user' : 'bot', m.content);

  /* The opener is scaffolding — once there is a conversation it is
     noise, so it goes and does not come back. */
  let rotate: number | undefined;
  const hideStarters = () => {
    clearInterval(rotate);
    suggest?.remove();
  };

  if (messages.length) {
    hideStarters();
  } else if (suggestBtn && suggestText) {
    const questions: string[] = JSON.parse(suggestBtn.dataset.qs ?? '[]');
    let i = 0;
    let paused = false;

    const label = () => suggestBtn.setAttribute('aria-label', `Ask: ${questions[i]}`);
    label();

    /* Cross-fade: the text swaps while it is invisible, so the width
       change never reads as a jump. */
    const advance = () => {
      if (paused || questions.length < 2) return;
      suggestText.classList.add('fading');
      setTimeout(() => {
        i = (i + 1) % questions.length;
        suggestText.textContent = questions[i];
        label();
        suggestText.classList.remove('fading');
      }, 320);
    };

    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!still) rotate = window.setInterval(advance, 5000);

    /* Hold still while someone is deciding whether to click it. */
    const hold = () => (paused = true);
    const release = () => (paused = false);
    suggestBtn.addEventListener('mouseenter', hold);
    suggestBtn.addEventListener('mouseleave', release);
    suggestBtn.addEventListener('focus', hold);
    suggestBtn.addEventListener('blur', release);

    suggestBtn.addEventListener('click', () => {
      input.value = questions[i];
      form.requestSubmit();
    });
  }

  const grow = () => {
    input.style.height = 'auto';
    input.style.height = Math.min(input.scrollHeight, 190) + 'px';
  };
  input.addEventListener('input', grow);

  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      form.requestSubmit();
    }
  });

  let busy = false;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const question = input.value.trim();
    if (!question || busy) return;

    if (messages.length >= MAX_TURNS) {
      bubble('bot', 'That is the end of this conversation. Her email is tiafowlkes@gmail.com.');
      return;
    }

    hideStarters();
    busy = true;
    send.disabled = true;
    input.value = '';
    grow();

    bubble('user', question);
    messages.push({ role: 'user', content: question });
    save();

    const out = bubble('bot', '');
    out.parentElement!.classList.add('thinking');
    let answer = '';

    try {
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages }),
      });

      const reader = res.body?.getReader();
      if (!reader) throw new Error('no stream');
      const dec = new TextDecoder();

      for (;;) {
        const { done, value } = await reader.read();
        if (done) break;
        answer += dec.decode(value, { stream: true });
        render(out, answer);
        out.parentElement!.classList.remove('thinking');
        out.scrollIntoView({ block: 'end' });
      }
    } catch {
      answer =
        answer ||
        'Something went wrong reaching the assistant. Her email is tiafowlkes@gmail.com.';
      render(out, answer);
    }

    out.parentElement!.classList.remove('thinking');
    messages.push({ role: 'assistant', content: answer });
    save();

    const left = MAX_TURNS - messages.length;
    if (left <= 3 && left > 0) {
      foot.textContent = `${Math.ceil(left / 2)} more question${left > 2 ? 's' : ''} in this conversation.`;
    } else if (left <= 0) {
      foot.textContent = 'Conversation complete. Her email is tiafowlkes@gmail.com.';
      input.disabled = true;
    }

    busy = false;
    send.disabled = false;
    input.focus();
  });
</script>

<!-- Bubbles are built by the script above, so they never carry Astro's
     scope attribute — these rules have to be global. They stay namespaced
     under #chat so nothing leaks to the rest of the site. -->
<style is:global>
  #chat .msg {
    max-width: 42rem;
    padding: 13px 17px;
    border-radius: 16px;
    font-size: 14px;
    line-height: 1.65;
    white-space: pre-wrap;
  }

  #chat .msg strong {
    font-weight: 600;
    color: var(--g-text);
  }

  #chat .msg.bot {
    align-self: flex-start;
    border: 1px solid rgba(16, 23, 30, 0.07);
    background: rgba(255, 255, 255, 0.72);
    border-bottom-left-radius: 5px;
    color: var(--g-text);
  }

  #chat .msg.user {
    align-self: flex-end;
    background: rgba(16, 23, 30, 0.9);
    border-bottom-right-radius: 5px;
    color: #f2f6fa;
  }

  /* Three dots while the first token is still in flight. */
  #chat .msg.thinking::after {
    content: '\00B7\00B7\00B7';
    display: block;
    font-size: 18px;
    letter-spacing: 2px;
    line-height: 1;
    color: var(--g-text-3);
    animation: ask-blink 1.3s ease-in-out infinite;
  }

  @keyframes ask-blink {
    0%,
    100% {
      opacity: 0.3;
    }
    50% {
      opacity: 1;
    }
  }

  @media (max-width: 720px) {
    #chat .msg {
      max-width: 100%;
    }
  }
</style>

<style>
  .chat {
    display: flex;
    flex-direction: column;
    padding: 0;
    border-radius: var(--r-md);
    overflow: hidden;
  }

  .thread {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 26px 26px 22px;
  }

  /* One opener at a time, cycling every five seconds. Shaped like
     the assistant's own bubble, because that is what it is — a
     suggestion — and clicking it asks the question. */
  .suggest-row {
    display: flex;
  }

  .suggest {
    max-width: 42rem;
    padding: 13px 18px;
    border: 1px solid rgba(16, 23, 30, 0.07);
    border-radius: 16px;
    border-bottom-left-radius: 5px;
    background: rgba(255, 255, 255, 0.72);
    font: inherit;
    font-size: 14px;
    line-height: 1.65;
    color: var(--g-text-2);
    text-align: left;
    cursor: pointer;
    transition: background 0.25s, border-color 0.25s, color 0.25s;
  }

  .suggest:hover,
  .suggest:focus-visible {
    border-color: rgba(16, 23, 30, 0.24);
    background: rgba(255, 255, 255, 0.95);
    color: var(--g-text);
  }

  .suggest span {
    display: block;
    transition: opacity 0.32s ease;
  }

  .suggest span.fading {
    opacity: 0;
  }

  .composer {
    display: flex;
    align-items: flex-end;
    gap: 10px;
    padding: 14px 16px;
    border-top: 1px solid rgba(16, 23, 30, 0.08);
    background: rgba(255, 255, 255, 0.5);
  }

  textarea {
    flex: 1;
    min-width: 0;
    padding: 11px 14px;
    border: 1px solid rgba(16, 23, 30, 0.12);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.86);
    font: inherit;
    font-size: 14px;
    line-height: 1.5;
    color: var(--g-text);
    resize: none;
  }

  textarea:focus-visible {
    outline: 2px solid rgba(16, 23, 30, 0.35);
    outline-offset: 1px;
  }

  textarea:disabled {
    opacity: 0.5;
  }

  button {
    flex: none;
    padding: 12px 20px;
    border: 0;
    border-radius: 12px;
    background: rgba(16, 23, 30, 0.9);
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    color: #f2f6fa;
    cursor: pointer;
    transition: background 0.2s;
  }

  button:hover:not(:disabled) {
    background: #10171e;
  }

  button:disabled {
    opacity: 0.45;
    cursor: default;
  }

  .foot {
    padding: 12px 18px 16px;
    border-top: 1px solid rgba(16, 23, 30, 0.06);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .thread {
      padding: 18px 16px 14px;
    }

    .composer {
      padding: 12px;
    }

    button {
      padding: 12px 15px;
    }
  }
</style>
