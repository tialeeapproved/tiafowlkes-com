---
import Page from '../layouts/Page.astro';
import { aiLead, aiProjects, aiTools } from '../data/ai';
---

<Page active="ai-fluency" lead={aiLead}>
  {/* The bot is not built yet, so this is deliberately inert — same
      posture as the `?` on the desktop. Both become links to /ask on
      the day the route exists; nothing else here has to change. */}
  <div class="tryme pane pop">
    <img
      class="kb"
      src="/icons/chat.png"
      width="42"
      height="42"
      alt=""
      aria-hidden="true"
    />

    <span class="copy">
      <span class="title">Try me</span>
      <span class="sub">Paste a role and see where I fit.</span>
    </span>

    <span class="soon meta">Coming soon</span>
  </div>

  <section class="matrix pane pop" aria-label="Tooling">
    <p class="label">Working toolkit</p>
    <div class="tools">
      {
        aiTools.map((t) => (
          <div class="tool">
            <img src={`/ai/${t.slug}.webp`} width="34" height="34" alt="" loading="lazy" />
            <div>
              <p class="name">{t.name}</p>
              <ul>
                {t.uses.map((u) => (
                  <li>{u}</li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <div class="cards">
    {
      aiProjects.map((p) => (
        <article class:list={['card', 'pane', 'pop', p.wide && 'wide']}>
          <h2>{p.name}</h2>
          <p class="descriptor">{p.descriptor}</p>

          {p.impact && <p class="impact">{p.impact}</p>}

          {p.pills && (
            <ul class="pills">
              {p.pills.map((s) => (
                <li>
                  {s.href ? (
                    <a class="pill" href={s.href} target="_blank" rel="noopener">
                      {s.name}
                    </a>
                  ) : (
                    <span class="pill">{s.name}</span>
                  )}
                  {s.builtWith && <span class="built meta">{s.builtWith}</span>}
                </li>
              ))}
            </ul>
          )}

          {p.tools && (
            <footer class="foot">
              <p class="meta">Built with: {p.tools.join(' · ')}</p>
            </footer>
          )}
        </article>
      ))
    }
  </div>

</Page>

<style>
  /* ---- try me ---- */
  .tryme {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 16px;
    padding: 18px 22px;
    border-radius: var(--r-md);
  }

  /* Grows and shrinks on a slow cycle. `pixelated` keeps the 21-pixel
     grid square while it scales. */
  .kb {
    display: block;
    flex: none;
    width: 42px;
    height: 42px;
    image-rendering: pixelated;
    transform-origin: center;
    animation: kb-breathe 3.6s ease-in-out infinite;
  }

  @keyframes kb-breathe {
    0%,
    100% {
      transform: scale(0.86);
    }
    50% {
      transform: scale(1.12);
    }
  }

  .copy {
    display: block;
    min-width: 0;
  }

  .title {
    display: block;
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--g-text);
  }

  .sub {
    display: block;
    margin-top: 2px;
    font-size: 13px;
    font-weight: 300;
    color: var(--g-text-2);
  }

  .soon {
    flex: none;
    margin-left: auto;
    padding: 5px 11px;
    border: 1px solid rgba(16, 23, 30, 0.09);
    border-radius: 100px;
    background: rgba(16, 23, 30, 0.045);
  }

  /* ---- project cards ---- */
  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .card {
    display: flex;
    flex-direction: column;
    padding: 26px 28px;
    border-radius: var(--r-md);
  }

  /* The roster is a different shape from a narrative, so it gets
     the full width rather than being squeezed into a column. */
  .wide {
    grid-column: 1 / -1;
  }

  h2 {
    font-size: 18px;
    font-weight: 400;
    letter-spacing: -0.015em;
    line-height: 1.25;
    color: var(--g-text);
  }

  .descriptor {
    margin: 6px 0 0;
    font-size: 13px;
    font-weight: 300;
    font-style: italic;
    color: var(--g-text-3);
  }

  .impact {
    margin-top: 16px;
    font-size: 14px;
    line-height: 1.65;
    color: var(--g-text-2);
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 10px 8px;
    margin-top: 18px;
  }

  .pills li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .pill {
    padding: 7px 14px;
    border: 1px solid rgba(16, 23, 30, 0.09);
    border-radius: 100px;
    background: rgba(16, 23, 30, 0.045);
    font-size: 13px;
    line-height: 1.4;
    color: var(--g-text-2);
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }

  a.pill:hover,
  a.pill:focus-visible {
    border-color: rgba(16, 23, 30, 0.28);
    background: rgba(16, 23, 30, 0.085);
    color: var(--g-text);
  }

  /* The attribution sits with the site it belongs to rather than in
     a sentence at the foot of the card — you read the claim on the
     thing making it. */
  .built {
    font-size: 10px;
  }

  .foot {
    margin-top: auto;
    padding-top: 20px;
  }

  /* ---- tool matrix ---- */
  .matrix {
    margin-bottom: 16px;
    padding: 26px 28px;
    border-radius: var(--r-md);
  }

  .matrix > .label {
    margin-bottom: 20px;
  }

  .tools {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 26px;
  }

  .tool {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .tool img {
    flex: none;
    width: 34px;
    height: 34px;
    object-fit: contain;
  }

  .tool .name {
    margin-bottom: 8px;
    font-size: 14px;
    font-weight: 500;
    color: var(--g-text);
  }

  .tool li {
    position: relative;
    padding-left: 14px;
    margin-bottom: 5px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--g-text-2);
  }

  .tool li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgba(16, 23, 30, 0.3);
  }

  @media (prefers-reduced-motion: reduce) {
    .kb {
      animation: none;
    }
  }

  @media (max-width: 860px) {
    .tools {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  @media (max-width: 720px) {
    .cards {
      grid-template-columns: 1fr;
    }

    .card,
    .matrix {
      padding: 22px 20px;
    }

    .tryme {
      flex-wrap: wrap;
      gap: 14px;
    }

    .soon {
      margin-left: 0;
    }
  }
</style>
