---
import Page from '../layouts/Page.astro';
import { aiProjects } from '../data/ai';

const lead =
  'Technical evaluation architecture and hands-on LLM development focused on rigorous model testing, hallucination mitigation, and deploying reliable generative features at scale.';
---

<Page active="ai-fluency" lead={lead}>
  <div class="cards">
    {
      aiProjects.map((p) => (
        <article class:list={['card', 'pane', 'pop', p.wide && 'wide']}>
          <h2>{p.name}</h2>
          <p class="descriptor">{p.descriptor}</p>

          {p.impact && <p class="impact">{p.impact}</p>}

          {p.pills && (
            <ul class="pills">
              {p.pills.map((s) => (
                <li class:list={['pill', s.ai && 'ai']}>{s.name}</li>
              ))}
            </ul>
          )}

          <footer class="foot">
            {p.tools && <p class="meta">Built with: {p.tools.join(' · ')}</p>}
            {p.note && <p class="meta">{p.note}</p>}
          </footer>
        </article>
      ))
    }
  </div>
</Page>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .card {
    display: flex;
    flex-direction: column;
    padding: 26px 28px;
    border-radius: var(--r-md);
  }

  /* The roster is a different shape from a narrative, so it gets
     the full width rather than being squeezed into a column. */
  .wide {
    grid-column: 1 / -1;
  }

  h2 {
    font-size: 18px;
    font-weight: 400;
    letter-spacing: -0.015em;
    line-height: 1.25;
    color: var(--g-text);
  }

  .descriptor {
    margin: 6px 0 0;
    font-size: 13px;
    font-weight: 300;
    font-style: italic;
    color: var(--g-text-3);
  }

  .impact {
    margin-top: 16px;
    font-size: 14px;
    line-height: 1.65;
    color: var(--g-text-2);
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }

  .pill {
    padding: 7px 14px;
    border: 1px solid rgba(16, 23, 30, 0.09);
    border-radius: 100px;
    background: rgba(16, 23, 30, 0.045);
    font-size: 13px;
    line-height: 1.4;
    color: var(--g-text-2);
  }

  /* Marked, because "built with Claude Code" is the claim this
     folder exists to make — it should be visible without reading
     the line underneath. */
  .pill.ai {
    border-color: rgba(16, 23, 30, 0.22);
    background: rgba(16, 23, 30, 0.075);
    font-weight: 500;
    color: var(--g-text);
  }

  /* Pushed to the foot of the card so the rule lines up across a
     row whatever length the prose above it runs to. `:first-of-type`
     will not do this job — it matches by element, and the descriptor
     is already the first <p> in the card. */
  .foot {
    margin-top: auto;
    padding-top: 20px;
  }

  .foot p + p {
    margin-top: 5px;
  }

  @media (max-width: 720px) {
    .cards {
      grid-template-columns: 1fr;
    }

    .card {
      padding: 22px 20px;
    }
  }
</style>
