---
import Page from '../layouts/Page.astro';
import { aiProjects, aiFramework, education } from '../data/ai';

const lead =
  'AI outputs fail probabilistically rather than deterministically. They return fluent, confident, and subtly flawed responses without structural warning indicators. Building effectively with generative models requires deep technical discipline, rigorous evaluation architecture, and the operational rigor to catch hallucinated accuracy before deployment.';
---

<Page active="ai-fluency" lead={lead}>
  <section class="framework pane pop">
    <p class="label">Evaluation framework</p>
    <p>{aiFramework}</p>
  </section>

  {
    aiProjects.length > 0 && (
      <div class="cards">
        {aiProjects.map((p) => (
          <a class="card pane pop" href={p.href} target="_blank" rel="noopener">
            {p.image ? (
              <img src={p.image} alt="" loading="lazy" />
            ) : (
              <span class="thumb" aria-hidden="true" />
            )}
            <span class="body">
              <span class="name">{p.name}</span>
              <span class="descriptor">{p.descriptor}</span>
              <span class="impact">{p.impact}</span>
              <span class="tools meta">Built with: {p.tools.join(' · ')}</span>
            </span>
          </a>
        ))}
      </div>
    )
  }

  <p class="education meta">{education}</p>
</Page>

<style>
  .framework {
    padding: 30px 32px;
    border-radius: var(--r-md);
  }

  .framework .label {
    margin-bottom: 14px;
  }

  .framework p:last-child {
    max-width: 76ch;
    font-size: 15px;
    font-weight: 300;
    line-height: 1.7;
    color: var(--g-text);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 20px;
  }

  .card {
    display: block;
    padding: 16px;
    border-radius: var(--r-md);
    transition: background 0.25s, border-color 0.25s;
  }

  .card:hover {
    border-color: rgba(255, 255, 255, 0.95);
  }

  .card img,
  .thumb {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--r-sm);
    background: linear-gradient(
      140deg,
      rgba(255, 255, 255, 0.7),
      rgba(255, 255, 255, 0.35)
    );
  }

  .body {
    display: block;
    padding: 18px 6px 4px;
  }

  .name {
    display: block;
    font-size: 17px;
    font-weight: 400;
    letter-spacing: -0.015em;
  }

  .descriptor {
    display: block;
    margin: 4px 0 12px;
    font-size: 13px;
    font-weight: 300;
    font-style: italic;
    color: var(--g-text-3);
  }

  .impact {
    display: block;
    font-size: 14px;
    line-height: 1.6;
    color: var(--g-text-2);
  }

  .tools {
    display: block;
    margin-top: 16px;
    padding-top: 12px;
    border-top: 1px solid var(--g-border-soft);
  }

  .education {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--g-border-soft);
  }

  @media (max-width: 720px) {
    .cards {
      grid-template-columns: 1fr;
    }

    .framework {
      padding: 24px 20px;
    }
  }
</style>
