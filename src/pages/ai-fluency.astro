---
import Page from '../layouts/Page.astro';
import Fieldset from '../components/Fieldset.astro';
import { aiProjects, aiFramework, education } from '../data/ai';

const lead =
  'AI outputs fail probabilistically rather than deterministically. They return fluent, confident, and subtly flawed responses without structural warning indicators. Building effectively with generative models requires deep technical discipline, rigorous evaluation architecture, and the operational rigor to catch hallucinated accuracy before deployment.';
---

<Page active="ai-fluency" lead={lead}>
  <Fieldset legend="Evaluation framework">
    <p class="framework">{aiFramework}</p>
  </Fieldset>

  {
    aiProjects.length > 0 && (
      <div class="cards">
        {aiProjects.map((p) => (
          <a class="card raised" href={p.href} target="_blank" rel="noopener">
            {p.image ? (
              <img src={p.image} alt="" loading="lazy" class="sunken" />
            ) : (
              <span class="thumb sunken" aria-hidden="true" />
            )}
            <span class="body">
              <span class="name">{p.name}</span>
              <span class="descriptor">{p.descriptor}</span>
              <span class="impact">{p.impact}</span>
              <span class="tools">Built with: {p.tools.join(' · ')}</span>
            </span>
          </a>
        ))}
      </div>
    )
  }

  <p class="education">{education}</p>
</Page>

<style>
  .framework {
    max-width: var(--measure);
    font-size: var(--size-body);
    line-height: 1.6;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s3);
    margin-top: var(--s4);
  }

  .card {
    display: block;
    padding: var(--s2);
  }

  .card:active {
    border-top-color: var(--ui-dark-shadow);
    border-left-color: var(--ui-dark-shadow);
    border-right-color: var(--ui-highlight);
    border-bottom-color: var(--ui-highlight);
  }

  .card img,
  .thumb {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .body {
    display: block;
    padding-top: var(--s2);
  }

  .name {
    display: block;
    font-size: 15px;
    font-weight: bold;
  }

  .descriptor {
    display: block;
    margin: 1px 0 6px;
    font-style: italic;
    font-size: 13px;
    color: #333;
  }

  .impact {
    display: block;
    font-size: 13px;
    line-height: 1.55;
  }

  .tools {
    display: block;
    margin-top: var(--s2);
    padding-top: 6px;
    border-top: 1px dotted var(--ui-face-line);
    font-family: var(--font-mono);
    font-size: 11px;
    color: #444;
  }

  .education {
    margin-top: var(--s6);
    padding-top: var(--s3);
    border-top: 1px solid var(--ui-shadow);
    box-shadow: 0 -1px 0 var(--ui-highlight) inset;
    font-size: 12px;
    color: #333;
  }

  @media (max-width: 720px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
