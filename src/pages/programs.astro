---
import Glass from '../layouts/Glass.astro';
import MetricStrip from '../components/MetricStrip.astro';
import { programsLead, portfolio, programs } from '../data/programs';
---

<Glass active="programs" lead={programsLead}>
  <!-- Breadth first. -->
  <section class="matrix" aria-label="Portfolio">
    {
      portfolio.map((col) => (
        <div class="col glass">
          <p class="label">{col.label}</p>
          <ul>
            {col.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>

  <!-- Depth second. -->
  <section class="detail" aria-label="Program detail">
    {
      programs.map((p) => (
        <article class="program glass" id={p.id}>
          <h2>{p.name}</h2>
          <p class="descriptor">{p.descriptor}</p>

          <MetricStrip metrics={p.metrics} />

          <ul class="points">
            {p.points.map((pt) => (
              <li>{pt}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </section>
</Glass>

<style>
  .matrix {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 20px;
  }

  .col {
    padding: 24px 22px;
    border-radius: var(--r-md);
  }

  .col .label {
    margin-bottom: 16px;
  }

  .col li {
    padding: 7px 0;
    font-size: 13px;
    line-height: 1.45;
    color: var(--g-text-2);
  }

  .col li + li {
    border-top: 1px solid var(--g-border-soft);
  }

  .detail {
    display: grid;
    gap: 20px;
  }

  .program {
    padding: 34px;
  }

  h2 {
    font-size: clamp(19px, 2.2vw, 25px);
    font-weight: 300;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .descriptor {
    margin: 8px 0 22px;
    font-size: 14px;
    font-weight: 300;
    font-style: italic;
    color: var(--g-text-3);
  }

  .points {
    max-width: 76ch;
  }

  .points li {
    position: relative;
    padding-left: 20px;
    margin-bottom: 12px;
    font-size: 14px;
    line-height: 1.65;
    color: var(--g-text-2);
  }

  .points li:last-child {
    margin-bottom: 0;
  }

  .points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.28);
  }

  @media (max-width: 1000px) {
    .matrix {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .matrix {
      grid-template-columns: 1fr;
    }

    .program {
      padding: 24px 20px;
      border-radius: var(--r-md);
    }
  }
</style>
