---
import Page from '../layouts/Page.astro';
import MetricStrip from '../components/MetricStrip.astro';
import { programsLead, portfolio, programs } from '../data/programs';
---

<Page active="programs" lead={programsLead}>
  <!-- Breadth first. -->
  <section class="portfolio" aria-labelledby="portfolio-h">
    <h2 id="portfolio-h">Portfolio</h2>

    <div class="matrix">
      {
        portfolio.map((col) => (
          <div class="col">
            <h3>{col.label}</h3>
            <ul>
              {col.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Depth second. -->
  <section class="detail" aria-label="Program detail">
    {
      programs.map((p) => (
        <article class="program" id={p.id}>
          <h3>{p.name}</h3>
          <p class="descriptor">{p.descriptor}</p>

          <MetricStrip metrics={p.metrics} />

          <ul class="points">
            {p.points.map((pt) => (
              <li>{pt}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </section>
</Page>

<style>
  .portfolio {
    padding-bottom: var(--s6);
  }

  .portfolio h2,
  .detail h3 {
    font-family: var(--font-display);
    letter-spacing: -0.02em;
  }

  .portfolio h2 {
    padding-bottom: var(--s2);
    margin-bottom: var(--s3);
    border-bottom: 1px solid var(--border);
    font-size: 1.2rem;
    font-weight: 600;
  }

  .matrix {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s3);
  }

  .col h3 {
    margin-bottom: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .col li {
    padding: 0.3rem 0;
    border-top: 1px solid var(--border-soft);
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--text-muted);
  }

  .program {
    padding: var(--s4) 0;
    border-top: 1px solid var(--border);
  }

  .program h3 {
    font-size: 1.35rem;
    font-weight: 600;
  }

  .descriptor {
    margin: 0.25rem 0 var(--s2);
    font-style: italic;
    color: var(--text-faint);
    font-size: 0.98rem;
  }

  .points {
    max-width: var(--measure);
  }

  .points li {
    position: relative;
    padding-left: 1.4rem;
    margin-bottom: 0.6rem;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.68em;
    width: 12px;
    height: 1px;
    background: var(--text-faint);
  }

  @media (max-width: 900px) {
    .matrix {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--s3) var(--s2);
    }
  }

  @media (max-width: 560px) {
    .matrix {
      grid-template-columns: 1fr;
    }
  }
</style>
