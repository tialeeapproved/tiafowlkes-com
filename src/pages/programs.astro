---
import Page from '../layouts/Page.astro';
import Fieldset from '../components/Fieldset.astro';
import MetricStrip from '../components/MetricStrip.astro';
import { programsLead, portfolio, programs } from '../data/programs';
---

<Page active="programs" lead={programsLead} wide>
  <!-- Breadth first. -->
  <section class="portfolio" aria-labelledby="portfolio-h">
    <h2 id="portfolio-h">Portfolio</h2>

    <div class="matrix">
      {
        portfolio.map((col) => (
          <Fieldset legend={col.label}>
            <ul class="list sunken">
              {col.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </Fieldset>
        ))
      }
    </div>
  </section>

  <!-- Depth second. -->
  <section class="detail" aria-label="Program detail">
    {
      programs.map((p) => (
        <article class="program" id={p.id}>
          <h3>{p.name}</h3>
          <p class="descriptor">{p.descriptor}</p>

          <MetricStrip metrics={p.metrics} />

          <ul class="points">
            {p.points.map((pt) => (
              <li>{pt}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </section>
</Page>

<style>
  h2 {
    font-size: 17px;
    font-weight: bold;
  }

  .matrix {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s3);
    margin-bottom: var(--s6);
  }

  .list {
    padding: 6px 8px;
  }

  .list li {
    padding: 2px 0;
    font-size: 12px;
    line-height: 1.5;
  }

  .list li + li {
    border-top: 1px dotted var(--ui-face-line);
  }

  .program {
    padding-top: var(--s4);
    margin-top: var(--s4);
    border-top: 1px solid var(--ui-shadow);
    box-shadow: 0 -1px 0 var(--ui-highlight) inset;
  }

  .program:first-child {
    padding-top: 0;
    margin-top: 0;
    border-top: none;
    box-shadow: none;
  }

  h3 {
    font-size: 17px;
    font-weight: bold;
  }

  .descriptor {
    margin: 2px 0 var(--s2);
    font-style: italic;
    font-size: 13px;
    color: #333;
  }

  .points {
    max-width: var(--measure);
  }

  .points li {
    position: relative;
    padding-left: 18px;
    margin-bottom: 7px;
    font-size: var(--size-body);
    line-height: 1.6;
  }

  /* Period bullet: a small raised square. */
  .points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 6px;
    height: 6px;
    background: var(--ui-bg);
    border-top: 1px solid var(--ui-highlight);
    border-left: 1px solid var(--ui-highlight);
    border-right: 1px solid var(--ui-dark-shadow);
    border-bottom: 1px solid var(--ui-dark-shadow);
  }

  @media (max-width: 900px) {
    .matrix {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .matrix {
      grid-template-columns: 1fr;
    }
  }
</style>
