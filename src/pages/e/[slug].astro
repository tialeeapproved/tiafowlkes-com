---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MenuBar from '../../components/MenuBar.astro';
import Window from '../../components/Window.astro';
import { allUnits, displayOrg } from '../../lib/query';
import { folders } from '../../data/folders';

export async function getStaticPaths() {
  const units = await allUnits();
  return units.map((unit) => ({
    params: { slug: unit.id },
    props: { unit },
  }));
}

const { unit } = Astro.props;
const { data } = unit;
const { Content } = await render(unit);

const inFolders = folders.filter((f) => data.tags.includes(f.tag as never));
---

<Base title={data.title} description={data.summary}>
  <MenuBar />

  <main class="shell">
    <nav class="crumbs mono" aria-label="Breadcrumb">
      <a href="/">desktop</a>
      {
        inFolders.map((f) => (
          <>
            <span aria-hidden="true">/</span>
            <a href={`/${f.id}`}>{f.label}</a>
          </>
        ))
      }
    </nav>

    <Window title={data.title} path={`~/e/${unit.id}`}>
      <div class="layout">
        <article class="prose">
          <p class="lede">{data.summary}</p>
          <Content />
        </article>

        <aside class="rail">
          <dl>
            <dt class="mono">Org</dt>
            <dd>{displayOrg(unit)}</dd>

            {data.role && (<><dt class="mono">Role</dt><dd>{data.role}</dd></>)}
            {data.period && (<><dt class="mono">When</dt><dd>{data.period}</dd></>)}

            {
              data.scale?.markets && (
                <><dt class="mono">Markets</dt><dd>{data.scale.markets}</dd></>
              )
            }
            {
              data.scale?.users && (
                <><dt class="mono">Users</dt><dd>{data.scale.users}</dd></>
              )
            }
            {
              data.scale?.stakeholders && (
                <>
                  <dt class="mono">Partners</dt>
                  <dd>{data.scale.stakeholders.join(', ')}</dd>
                </>
              )
            }
          </dl>

          {
            data.outcome && (
              <div class="outcome">
                <b>{data.outcome.value}</b>
                <span class="mono">{data.outcome.label}</span>
              </div>
            )
          }
        </aside>
      </div>
    </Window>
  </main>
</Base>

<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding: var(--s3) 0 var(--s2);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 200px;
    gap: var(--s4);
  }

  .prose {
    max-width: var(--measure);
  }

  .lede {
    margin-bottom: var(--s3);
    font-size: 1.08rem;
    color: var(--text);
  }

  .prose :global(h2) {
    margin: var(--s3) 0 var(--s1);
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--accent);
  }

  .prose :global(p) {
    margin-bottom: var(--s2);
    color: var(--text-muted);
  }

  .prose :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .prose :global(ul) {
    margin-bottom: var(--s2);
  }

  .prose :global(li) {
    position: relative;
    padding-left: 1.1rem;
    margin-bottom: 0.35rem;
    color: var(--text-muted);
  }

  .prose :global(li)::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--text-faint);
  }

  .rail {
    padding-left: var(--s3);
    border-left: 1px solid var(--border-soft);
  }

  dl {
    margin: 0;
  }

  dt {
    margin-bottom: 0.15rem;
  }

  dd {
    margin: 0 0 var(--s2);
    font-size: 0.88rem;
  }

  .outcome b {
    display: block;
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--accent);
  }

  @media (max-width: 820px) {
    .layout {
      grid-template-columns: 1fr;
      gap: var(--s3);
    }

    .rail {
      padding-left: 0;
      padding-top: var(--s2);
      border-left: none;
      border-top: 1px solid var(--border-soft);
    }
  }
</style>
