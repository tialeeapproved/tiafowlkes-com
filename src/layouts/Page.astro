---
import Base from './Base.astro';
import Sky from '../components/Sky.astro';
import Taskbar from '../components/Taskbar.astro';
import FolderIcons from '../components/FolderIcons.astro';
import GlassWin from '../components/GlassWin.astro';
import Me from '../components/Me.astro';
import '../styles/glass.css';
import { getFolder, type FolderId } from '../data/folders';

interface Props {
  active: FolderId | 'ask';
  lead: string;
  /* Ask is not a folder, so it brings its own title and eyebrow. */
  title?: string;
  eyebrow?: string;
}

const { active, lead, title, eyebrow } = Astro.props;
const folder = getFolder(active);
const heading = title ?? folder!.label;
const kicker = eyebrow ?? folder!.eyebrow;
---

<Base title={heading} description={lead} fonts>
  <!-- The desktop is identical on every page. Only the window
       on top of it changes. -->
  <Sky />

  <div class="workspace">
    <div class="rail">
      <FolderIcons active={active} />
    </div>

    <main class="stage g" id="main">
      <GlassWin title={heading}>
        <header class="lead">
          <p class="label">{kicker}</p>
          <h1>{heading}</h1>
          <p class="sub">{lead}</p>
        </header>

        <slot />
      </GlassWin>
    </main>
  </div>

  <!-- Rendered, then faded out — the transition has to happen on
       arrival, since each page is a fresh document. -->
  <Me state="out" />

  <Taskbar active={active} />
</Base>

<style>
  .workspace {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    /* Exactly one viewport. The page never scrolls — the window
       does — so the gap around the frame is always visible. */
    height: calc(100vh - var(--taskbar-h));
    height: calc(100dvh - var(--taskbar-h));
    padding: 22px;
  }

  /* The folders sit on the desktop, not in the document flow —
     so the window can centre on the page rather than being
     pushed to whatever space is left beside them. */
  .rail {
    position: fixed;
    top: 22px;
    left: 22px;
    z-index: 20;
  }

  .stage {
    flex: 1;
    min-height: 0;
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
  }

  .lead {
    max-width: 66ch;
    padding-bottom: 30px;
    margin-bottom: 30px;
    border-bottom: 1px solid var(--g-border-soft);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.6);
  }

  .lead .label {
    display: block;
    margin-bottom: 14px;
  }

  .lead h1 {
    margin-bottom: 18px;
  }

  .sub {
    font-size: 16px;
    font-weight: 300;
    line-height: 1.62;
    color: var(--g-text-2);
  }

  /* Desktop: reserve the rail's width on BOTH sides so the window
     stays centred on screen and still clears the folders. Padding
     only one side would slide the window off-centre. */
  @media (min-width: 901px) {
    .workspace {
      padding-left: calc(var(--rail-w) + 40px);
      padding-right: calc(var(--rail-w) + 40px);
    }
  }

  /* Tablet and phone: the rail rejoins the flow as a row across the
     top — a home screen, not a shrunken desktop. */
  @media (max-width: 900px) {
    .workspace {
      gap: 16px;
      padding: 14px 14px 16px;
    }

    .rail {
      position: static;
      flex: none;
      width: 100%;
    }

    .stage {
      width: 100%;
      max-width: none;
    }

    .lead {
      padding-bottom: 22px;
      margin-bottom: 22px;
    }

    .lead h1 {
      margin-bottom: 14px;
    }

    .sub {
      font-size: 15px;
    }
  }

  @media (max-width: 560px) {
    .workspace {
      padding: 10px 10px 12px;
      gap: 12px;
    }

    .sub {
      font-size: 14px;
    }
  }
</style>
