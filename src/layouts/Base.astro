---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /* Content pages need Inter and JetBrains Mono for the glass
     windows. The desktop needs neither, so it loads neither. */
  fonts?: boolean;
}

const { title, description = site.tagline, fonts = false } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;

/* Share cards need absolute URLs — a scraper has no page to resolve a
   relative path against. `Astro.site` is set in `astro.config.mjs`, so
   these are correct in production regardless of which host served the
   build. */
const ogImage = new URL('/og.png', Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />

    {/* Tia's own card art. 1200x630 is the frame every platform crops
        toward, so it is built at that ratio rather than left square and
        cropped to something she did not choose. The dimensions are
        declared because LinkedIn and Slack lay the card out before the
        image finishes downloading; without them the card can settle at
        the small thumbnail size and never grow. */}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={`${site.name} — ${site.role}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${site.name} — ${site.role}`} />
    <meta name="theme-color" content="#3b78a5" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />

    {/* Did you arrive from the desktop? This has to be answered in the
        head, before a single pixel of the body is painted. Asking any
        later — from a script next to the element — leaves a real
        chance the browser paints one frame with Tia already hidden
        before the answer lands, and that frame is the blink. */}
    <script is:inline>
      (function () {
        try {
          var u = new URL(document.referrer);
          if (u.origin === location.origin && u.pathname === '/') {
            document.documentElement.setAttribute('data-from', 'desktop');
          }
        } catch (e) {}
      })();
    </script>
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {
      fonts && (
        <>
          {/* ⚠️ This stylesheet must never block rendering. Read this
              before changing it back to a plain <link rel="stylesheet">.

              A stylesheet in the head blocks first paint until it
              answers. Because every navigation here is a real page
              load, that meant a round trip to fonts.googleapis.com
              before ANY pixel of the new page could be drawn — on every
              single folder click. The desktop is identical across
              pages, so what a visitor saw was the sky, the folders and
              the taskbar going away and coming back: the blink.

              It also silently disabled the page transition. Chrome
              abandons a cross-document view transition when the
              incoming document cannot render promptly, so the fade was
              never running — measured, not assumed.

              `media="print"` makes the browser fetch it without waiting
              on it; the onload flips it to apply. The page paints
              immediately in the fallback stack and swaps when the
              webfont lands. */}
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link
            rel="preload"
            as="style"
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=JetBrains+Mono:wght@400;600&display=swap"
          />
          <link
            rel="stylesheet"
            media="print"
            onload="this.media='all';this.onload=null"
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=JetBrains+Mono:wght@400;600&display=swap"
          />
          <noscript>
            <link
              rel="stylesheet"
              href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=JetBrains+Mono:wght@400;600&display=swap"
            />
          </noscript>
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
