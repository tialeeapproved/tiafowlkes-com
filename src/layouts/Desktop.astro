---
import Base from './Base.astro';
import MenuBar from '../components/MenuBar.astro';
import ImpactStrip from '../components/ImpactStrip.astro';
import FolderIcons from '../components/FolderIcons.astro';
import Window from '../components/Window.astro';
import EvidenceCard from '../components/EvidenceCard.astro';
import { folders, getFolder, type FolderId } from '../data/folders';
import { allUnits, unitsInFolder } from '../lib/query';

interface Props {
  active: FolderId;
}

const { active } = Astro.props;
const folder = getFolder(active)!;

/* Every folder is a query over the same library — nothing is
   duplicated, and counts stay honest automatically. */
const units = await unitsInFolder(folder);
const all = await allUnits();

const counts: Record<string, number> = {};
for (const f of folders) {
  counts[f.id] = all.filter((u) => u.data.tags.includes(f.tag as never)).length;
}
---

<Base title={folder.label} description={folder.question}>
  <MenuBar />

  <main class="shell">
    <ImpactStrip />
    <FolderIcons active={active} counts={counts} />

    <Window title={folder.label} subtitle={folder.question} path={`~/${active}`}>
      {
        units.length === 0 ? (
          <p class="empty">
            Nothing here yet — this folder is scaffolded and waiting on content.
          </p>
        ) : (
          <div class="stack">
            {units.map((unit) => (
              <EvidenceCard unit={unit} />
            ))}
          </div>
        )
      }
    </Window>
  </main>

  <footer class="shell foot mono">
    <span>© {new Date().getFullYear()} tia fowlkes</span>
    <a href="/list">View as list</a>
  </footer>
</Base>

<style>
  .stack {
    display: grid;
    gap: var(--s2);
  }

  .empty {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .foot {
    display: flex;
    justify-content: space-between;
    gap: var(--s2);
    padding-bottom: var(--s4);
  }
</style>
