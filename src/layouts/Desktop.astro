---
import Base from './Base.astro';
import Sky from '../components/Sky.astro';
import Taskbar from '../components/Taskbar.astro';
import FolderIcons from '../components/FolderIcons.astro';
import { site } from '../data/site';
---

<Base description={site.tagline}>
  <Sky />

  <main class="desktop" id="main">
    <FolderIcons />
  </main>

  <Taskbar />
</Base>

<style>
  .desktop {
    position: relative;
    z-index: 10;
    min-height: calc(100vh - var(--taskbar-h));
    padding: 22px;
  }

  @media (max-width: 720px) {
    .desktop {
      padding: 18px 14px;
    }
  }
</style>
