---
import Base from './Base.astro';
import Sky from '../components/Sky.astro';
import Taskbar from '../components/Taskbar.astro';
import FolderIcons from '../components/FolderIcons.astro';
import Me from '../components/Me.astro';
import { site } from '../data/site';
---

<Base description={site.tagline}>
  <Sky />

  <main class="desktop" id="main">
    <FolderIcons />
  </main>

  <Me />

  <Taskbar />
</Base>

<style>
  /* The inset comes from `--desk-x` / `--desk-y`, shared with
     `.workspace` on the folder pages, so the folder strip sits in
     exactly the same place before and after a navigation. */
  .desktop {
    position: relative;
    z-index: 10;
    min-height: calc(100vh - var(--taskbar-h));
    padding: var(--desk-y) var(--desk-x);
  }
</style>
